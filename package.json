{
  "name": "epub-audiobook-generator",
  "version": "1.0.0",
  "description": "Convert EPUB books into high-quality audiobooks with AI voices",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test-all.js",
    "test:sync": "node scripts/test-sync.js",
    "audit:ui": "node scripts/audit-ui.js",
    "pack": "node scripts/pack.js",
    "unpack": "node scripts/unpack.js",
    "tunnel": "cloudflared tunnel --protocol http2 --url http://localhost:5173"
  },
  "keywords": [
    "epub",
    "audiobook",
    "tts",
    "text-to-speech"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "edge-tts-universal": "^1.4.0",
    "epub": "^2.1.1",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "google-translate-api-x": "^10.7.3",
    "groq-sdk": "^1.5.0",
    "html-to-text": "^10.0.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uuid": "^14.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "puppeteer-core": "^21.11.0",
    "vite": "^8.2.1"
  }
}
